#
# Entry point for the SoC-level defaults.
# ----------------------------------------------------------------------------
# Sourced directly by the generated osource "<vendor>/Kconfig.defconfig" (see
# the comment at the top of Kconfig in this directory).
#
# The sub-directory Kconfig.defconfig must be pulled in here, otherwise none of
# the SOC / NUM_IRQS / XIP / CPU frequency defaults in bk7258/Kconfig.defconfig
# take effect, and nothing is reported.

if SOC_FAMILY_BEKEN_ARM

rsource "*/Kconfig.defconfig"

endif # SOC_FAMILY_BEKEN_ARM
