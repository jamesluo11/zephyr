#
# SoC-level defaults. Anything that differs per board belongs in the board.

if SOC_BK7258

# Interrupts go straight to the NVIC; there is no cascaded interrupt controller.
config NUM_IRQS
	default 64

# Code executes in place from the flash window and is not copied to SRAM.
config XIP
	default y

# The image starts at the beginning of the zephyr,flash region.
config FLASH_LOAD_OFFSET
	default 0x0

# The device starts on its 26 MHz crystal and the first stage leaves the core
# there. The firmware the device ships with raises it to 120 MHz instead.
config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 120000000 if SOC_BK7258_VENDOR_FIRMWARE
	default 26000000

# The firmware the device ships with configured UART0 before this image
# started; without it the driver has to set the port up itself.
config UART_BK7258_NO_HW_INIT
	default y if SOC_BK7258_VENDOR_FIRMWARE

# TrustZone, not a bare MPU, is what isolates the core.
config ARM_MPU
	default n

# There are no clock gating registers to configure.
config CLOCK_CONTROL
	default n

endif # SOC_BK7258
