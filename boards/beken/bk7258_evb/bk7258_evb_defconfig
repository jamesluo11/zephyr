#
# Board defconfig for the BK7258 EVB.
#
# The architecture, the CPU model and the core clock are properties of the SoC
# and come in through its select chain, so they are not repeated here.

CONFIG_MAIN_STACK_SIZE=2048
CONFIG_SYSTEM_WORKQUEUE_STACK_SIZE=2048
CONFIG_ISR_STACK_SIZE=2048

CONFIG_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_UART_CONSOLE=y
CONFIG_PRINTK=y

# UART0 on this board is driven by the SoC's other core, which has already
# configured it as its console. The application core only borrows the port, so
# the driver must not touch the hardware, or it would leave the other core's
# console broken and the board silent. See the option's help text.
CONFIG_UART_BK7258_NO_HW_INIT=y

CONFIG_HEAP_MEM_POOL_SIZE=4096
